# Server
BD_CLOUD_PORT=8787
BD_CLOUD_HOST=0.0.0.0
BD_CLOUD_BASE_URL=http://localhost:8787
BD_CLOUD_ENV=development

# Auth — CHANGE THIS in production!
SESSION_SECRET=replace-with-a-long-random-secret
BD_INTERNAL_OWNER_EMAILS=
BD_ANALYTICS_ADMIN_EMAILS=
BD_SUPPORT_ADMIN_EMAILS=

# Future production services
DATABASE_URL=postgres://bd_engine:bd_engine@localhost:5432/bd_engine_cloud
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_JOBSEEKER=
STRIPE_PRICE_SALES=
OPENAI_API_KEY=

# Transactional email (password reset and advisory email verification)
RESEND_API_KEY=
BD_EMAIL_FROM=
# Optional alert destination for server-side 5xx events
BD_ERROR_WEBHOOK=
BD_CLOUD_SMOKE_ALLOW_MUTATIONS=false
BD_EXPOSE_RESET_TOKEN=false
BD_ALLOW_TEST_CHECKOUT=false
BD_ENABLE_SYNTHETIC_ERROR=false
BD_REQUIRE_EMAIL_VERIFICATION=false
BD_SUPPORT_CREATE_MAX=10
BD_SUPPORT_REPLY_MAX=30

# Private JavaScript careers-page renderer (configure both or neither)
BD_ATS_RENDER_SERVICE_URL=
BD_ATS_RENDER_SERVICE_TOKEN=
BD_ATS_RENDER_TIMEOUT_MS=20000

# Relational migration canaries (comma-separated tenant IDs or *)
BD_RELATIONAL_MIRROR=true
BD_RELATIONAL_READ_TENANTS=
BD_RELATIONAL_SQL_TENANTS=
BD_RELATIONAL_SQL_CONTACT_TENANTS=
BD_RELATIONAL_SQL_JOB_TENANTS=
BD_RELATIONAL_SQL_CONFIG_TENANTS=
BD_RELATIONAL_USAGE_TENANTS=
BD_RELATIONAL_DEEP_CHECK_TENANTS=
BD_RELATIONAL_WRITE_TENANTS=
BD_RELATIONAL_WRITE_NEW_TENANTS=false

# Process memory bounds
BD_RESIDENT_TENANT_LIMIT=8
BD_RESIDENT_TENANT_IDLE_MS=300000
BD_BACKGROUND_JOB_RETENTION_MS=3600000
BD_MAX_RATE_BUCKETS=10000
BD_MAX_RESET_TOKEN_CACHE=5000
BD_DB_POOL_MAX=5
